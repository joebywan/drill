{
  "id": "move",
  "title": "Move",
  "units": [
    {
      "title": "Wake up",
      "lessons": [
        {
          "id": "wake1",
          "title": "Loosen up",
          "items": [
            {
              "id": "wake-teach",
              "type": "teach",
              "help": true,
              "say": "Hi, I'm Clover. Copy me, nice and easy.",
              "text": [
                "A few gentle moves to wake your body up: neck, shoulders, arms and sides.",
                "Each move has a little timer. Go at your own pace, and make the moves as small as feels good.",
                "Rests come in between. Stand, or sit on a sturdy chair: both work."
              ]
            },
            { "id": "wake-a", "type": "routine", "set": [
              { "move": "neck-tilt", "seconds": 30 },
              { "move": "shoulder-roll", "reps": 8 },
              { "move": "reach-up", "seconds": 30 },
              { "move": "side-bend-left", "seconds": 20 },
              { "move": "side-bend-right", "seconds": 20 }
            ] }
          ]
        },
        { "id": "wake2", "title": "A bit longer", "items": [{ "id": "wake-b", "type": "routine", "set": [
          { "move": "neck-tilt", "seconds": 40 },
          { "move": "shoulder-roll", "reps": 10 },
          { "move": "reach-up", "seconds": 40 },
          { "move": "side-bend-left", "seconds": 30 },
          { "move": "side-bend-right", "seconds": 30 }
        ] }] },
        { "id": "wake3", "title": "Morning flow", "items": [{ "id": "wake-c", "type": "routine", "set": [
          { "move": "neck-tilt", "seconds": 40 },
          { "move": "shoulder-roll", "reps": 12 },
          { "move": "reach-up", "seconds": 40 },
          { "move": "side-bend-left", "seconds": 30 },
          { "move": "side-bend-right", "seconds": 30 },
          { "move": "march", "seconds": 40 }
        ] }] }
      ]
    },
    {
      "title": "Strength",
      "lessons": [
        {
          "id": "strength1",
          "title": "First sets",
          "items": [
            {
              "id": "strength-teach",
              "type": "teach",
              "say": "Strength time. Your own body is all the kit we need.",
              "text": [
                "Wall push-ups, squats and marching on the spot. Slow and steady beats lots.",
                "The count is a guide, not a target. Stop early whenever you like, and rest as long as you want.",
                "A sturdy chair behind you makes squats easier: just touch it and stand back up."
              ]
            },
            { "id": "strength-a", "type": "routine", "set": [
              { "move": "march", "seconds": 30 },
              { "move": "wall-push", "reps": 5 },
              { "move": "squat", "reps": 5 },
              { "move": "march", "seconds": 30 }
            ] }
          ]
        },
        { "id": "strength2", "title": "A few more", "items": [{ "id": "strength-b", "type": "routine", "set": [
          { "move": "march", "seconds": 40 },
          { "move": "wall-push", "reps": 8 },
          { "move": "squat", "reps": 8 },
          { "move": "march", "seconds": 40 }
        ] }] },
        { "id": "strength3", "title": "Two rounds", "items": [{ "id": "strength-c", "type": "routine", "set": [
          { "move": "march", "seconds": 40 },
          { "move": "wall-push", "reps": 10 },
          { "move": "squat", "reps": 10 },
          { "move": "march", "seconds": 30 },
          { "move": "wall-push", "reps": 8 },
          { "move": "squat", "reps": 8 }
        ] }] }
      ]
    },
    {
      "title": "Stretch",
      "lessons": [
        {
          "id": "stretch1",
          "title": "Slow stretch",
          "items": [
            {
              "id": "stretch-teach",
              "type": "teach",
              "say": "Stretching. The slowest thing we do. I'm a big fan.",
              "text": [
                "Ease into each stretch until you feel a gentle pull, then hold it and breathe.",
                "No bouncing, and no forcing. A stretch should feel good, never sharp.",
                "If one side feels different from the other, that's normal."
              ]
            },
            { "id": "stretch-a", "type": "routine", "set": [
              { "move": "reach-up", "seconds": 30 },
              { "move": "side-bend-left", "seconds": 30 },
              { "move": "side-bend-right", "seconds": 30 },
              { "move": "lunge-left", "seconds": 30 },
              { "move": "lunge-right", "seconds": 30 }
            ] }
          ]
        },
        { "id": "stretch2", "title": "Longer holds", "items": [{ "id": "stretch-b", "type": "routine", "set": [
          { "move": "neck-tilt", "seconds": 30 },
          { "move": "reach-up", "seconds": 40 },
          { "move": "side-bend-left", "seconds": 40 },
          { "move": "side-bend-right", "seconds": 40 },
          { "move": "lunge-left", "seconds": 40 },
          { "move": "lunge-right", "seconds": 40 }
        ] }] }
      ]
    }
  ],
  "again": { "label": "Move", "lesson": "wake3" },
  "moves": {
    "neck-tilt": { "pose": "neck-tilt", "name": "Neck tilts", "how": ["Ear towards your shoulder, slowly.", "Pause for a breath, then over to the other side.", "Shoulders stay low. Small is fine."] },
    "shoulder-roll": { "pose": "shoulder-roll", "name": "Shoulder rolls", "how": ["Lift your shoulders up towards your ears.", "Roll them back, then let them drop.", "Arms hang loose."], "pace": 4, "unit": "shoulder rolls" },
    "reach-up": { "pose": "reach-up", "name": "Reach up", "how": ["Arms up high, like you're picking fruit from a tall tree.", "Breathe out and lower.", "Staying seated works too."] },
    "side-bend-left": { "pose": "side-bend-left", "name": "Side bend, left", "how": ["Right arm up and over.", "Lean gently to the left.", "Feel the stretch along your side."] },
    "side-bend-right": { "pose": "side-bend-right", "name": "Side bend, right", "how": ["Left arm up and over.", "Lean gently to the right.", "Feel the stretch along your side."] },
    "march": { "pose": "march", "name": "March on the spot", "how": ["Lift your knees at an easy pace.", "Let your arms swing.", "Low knees are fine."] },
    "wall-push": { "pose": "wall-push", "name": "Wall push-ups", "how": ["Hands on the wall at shoulder height.", "Bend your elbows and lean in.", "Push back to the start."], "pace": 4, "unit": "wall push-ups" },
    "squat": { "pose": "squat", "name": "Squats", "how": ["Feet hip-width.", "Sit back like there's a chair behind you.", "Stand tall."], "pace": 4, "unit": "squats" },
    "lunge-left": { "pose": "lunge", "name": "Lunge stretch, left leg", "how": ["Step your left foot forward.", "Bend that knee a little.", "Feel the stretch in the back leg's hip."] },
    "lunge-right": { "pose": "lunge", "name": "Lunge stretch, right leg", "how": ["Step your right foot forward.", "Bend that knee a little.", "Easy does it."] }
  }
}
