{
  "id": "japanese",
  "title": "Japanese",
  "lang": "ja-JP",
  "units": [
    {
      "title": "Vowels",
      "lessons": [
        {
          "id": "v1",
          "title": "あ い う",
          "items": [
            {
              "id": "v1-kana",
              "type": "teach",
              "show": "あ",
              "read": "a",
              "speak": "あ",
              "text": "Japanese is written in kana: symbols that each make one sound. Hiragana is the first set of them. Under each one I write its sound in English letters. See a speaker? Tap it to hear it."
            },
            {
              "id": "v1-teach-1",
              "type": "teach",
              "show": "あ",
              "read": "a",
              "speak": "あ",
              "text": "This is あ, said \"a\" as in \"ah\". See the cross with a big loop swinging off it? Someone on a swing going \"aah\"."
            },
            {
              "id": "v1-teach-2",
              "type": "teach",
              "show": "い",
              "read": "i",
              "speak": "い",
              "text": "い is \"i\", the \"ee\" in \"see\". Two strokes standing side by side, like two eels poking up: \"ee\"."
            },
            {
              "id": "v1-pick-3",
              "type": "pick",
              "show": "あ",
              "speak": "あ",
              "prompt": "Which sound is this?",
              "options": [
                "a",
                "i"
              ],
              "answer": "a",
              "explain": "あ reads \"a\"."
            },
            {
              "id": "v1-pick-4",
              "type": "pick",
              "show": "い",
              "speak": "い",
              "prompt": "Which sound is this?",
              "options": [
                "i",
                "a"
              ],
              "answer": "i",
              "explain": "い reads \"i\"."
            },
            {
              "id": "v1-teach-5",
              "type": "teach",
              "show": "う",
              "read": "u",
              "speak": "う",
              "text": "う is \"u\", the \"oo\" in \"zoo\". A little dash on top of a curve: lips pushed out to say \"oo\"."
            },
            {
              "id": "v1-pick-6",
              "type": "pick",
              "show": "う",
              "speak": "う",
              "prompt": "Which sound is this?",
              "options": [
                "a",
                "u",
                "i"
              ],
              "answer": "u",
              "explain": "う reads \"u\"."
            },
            {
              "id": "v1-listen-7",
              "type": "pick",
              "listen": true,
              "show": "a",
              "speak": "あ",
              "prompt": "Which kana is this sound?",
              "options": [
                "い",
                "あ",
                "う"
              ],
              "answer": "あ",
              "explain": "That was \"a\": あ."
            },
            {
              "id": "v1-pairs-8",
              "type": "pairs",
              "prompt": "Match each kana to its sound. Tap one, then its partner.",
              "pairs": [
                [
                  "あ",
                  "a"
                ],
                [
                  "い",
                  "i"
                ],
                [
                  "う",
                  "u"
                ]
              ],
              "explain": "あ a, い i, う u."
            }
          ]
        },
        {
          "id": "v2",
          "title": "え お",
          "items": [
            {
              "id": "v2-teach-9",
              "type": "teach",
              "show": "え",
              "read": "e",
              "speak": "え",
              "text": "え is \"e\", as in \"eh\". A dancer: one arm flung up top, a leg kicking out below. \"Eh!\""
            },
            {
              "id": "v2-pick-10",
              "type": "pick",
              "show": "え",
              "speak": "え",
              "prompt": "Which sound is this?",
              "options": [
                "u",
                "e",
                "i"
              ],
              "answer": "e",
              "explain": "え reads \"e\"."
            },
            {
              "id": "v2-teach-11",
              "type": "teach",
              "show": "お",
              "read": "o",
              "speak": "お",
              "text": "お is \"o\", as in \"oh\". It is あ with a ball flying off the top right: \"oh, there it goes\"."
            },
            {
              "id": "v2-pick-12",
              "type": "pick",
              "show": "お",
              "speak": "お",
              "prompt": "Which sound is this?",
              "options": [
                "a",
                "o",
                "e"
              ],
              "answer": "o",
              "explain": "お reads \"o\"."
            },
            {
              "id": "v2-which-13",
              "type": "pick",
              "show": "o",
              "prompt": "Which kana says \"o\"?",
              "options": [
                "あ",
                "お"
              ],
              "answer": "お",
              "explain": "\"o\" is お."
            },
            {
              "id": "v2-listen-14",
              "type": "pick",
              "listen": true,
              "show": "e",
              "speak": "え",
              "prompt": "Which kana is this sound?",
              "options": [
                "え",
                "う",
                "お"
