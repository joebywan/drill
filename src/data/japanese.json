              "answer": "え",
              "explain": "That was \"e\": え."
            },
            {
              "id": "v2-pairs-15",
              "type": "pairs",
              "prompt": "Match each kana to its sound.",
              "pairs": [
                [
                  "あ",
                  "a"
                ],
                [
                  "い",
                  "i"
                ],
                [
                  "う",
                  "u"
                ],
                [
                  "え",
                  "e"
                ],
                [
                  "お",
                  "o"
                ]
              ],
              "explain": "あ a, い i, う u, え e, お o."
            }
          ]
        },
        {
          "id": "v3",
          "title": "All five",
          "items": [
            {
              "id": "v3-teach-16",
              "type": "teach",
              "show": "あいうえお",
              "read": "a i u e o",
              "speak": "あいうえお",
              "text": "These five sounds are the vowels. Kana come in sets called rows, and this is the vowel row. Every other row is built on these same five, with a new sound in front. This one is about a tenth of all hiragana."
            },
            {
              "id": "v3-pick-17",
              "type": "pick",
              "show": "い",
              "speak": "い",
              "prompt": "Which sound is this?",
              "options": [
                "e",
                "i",
                "u"
              ],
              "answer": "i",
              "explain": "い reads \"i\"."
            },
            {
              "id": "v3-which-18",
              "type": "pick",
              "show": "a",
              "prompt": "Which kana says \"a\"?",
              "options": [
                "お",
                "あ",
                "え"
              ],
              "answer": "あ",
              "explain": "\"a\" is あ."
            },
            {
              "id": "v3-listen-19",
              "type": "pick",
              "listen": true,
              "show": "o",
              "speak": "お",
              "prompt": "Which kana is this sound?",
              "options": [
                "あ",
                "お",
                "え"
              ],
              "answer": "お",
              "explain": "That was \"o\": お."
            },
            {
              "id": "v3-words",
              "type": "teach",
              "show": "あお",
              "read": "ao",
              "speak": "あお",
              "text": "Kana join up to make words. Read left to right, each kana keeping its own sound: あ a, お o, so あお says \"ao\". It means blue. To build a word, tap its tiles in order."
            },
            {
              "id": "v3-build-20",
              "type": "build",
              "show": "ao: blue",
              "speak": "あお",
              "prompt": "Build \"ao\" from the tiles.",
              "answer": [
                "あ",
                "お"
              ],
              "tiles": [
                "い"
              ],
              "explain": "あお is あ a + お o: blue."
            },
            {
              "id": "v3-build-21",
              "type": "build",
              "show": "ie: house",
              "speak": "いえ",
              "prompt": "Build \"ie\" from the tiles.",
              "answer": [
                "い",
                "え"
              ],
              "tiles": [
                "う"
              ],
              "explain": "いえ is い i + え e: house."
            },
            {
              "id": "v3-pairs-22",
              "type": "pairs",
              "prompt": "Match each kana to its sound.",
              "pairs": [
                [
                  "お",
                  "o"
                ],
                [
                  "え",
                  "e"
                ],
                [
                  "う",
                  "u"
                ],
                [
                  "い",
                  "i"
                ],
                [
                  "あ",
                  "a"
                ]
              ],
              "explain": "お o, え e, う u, い i, あ a."
            }
          ]
        }
      ]
    },
    {
