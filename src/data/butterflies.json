{
  "species": [
    {"id":"chequered-swallowtail","name":"Chequered Swallowtail","latin":"Papilio demoleus","raisedBy":"chess","lines":[{"text":"Usually seen flying in one direction at a steady height, and it lands only now and then.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/demoleus.html","publisher":"Butterfly House"}},{"text":"Its wings are about 10 cm across.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/demoleus.html","publisher":"Butterfly House"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#2A2620","dots":[[14,18,2.6,"#F2D04A"],[10,27,2.4,"#F2D04A"],[20,25,2.8,"#F2D04A"],[30,20,2.6,"#F2D04A"],[28,31,3,"#F2D04A"],[38,26,2.6,"#F2D04A"],[26,40,2.8,"#F2D04A"],[38,38,3,"#F2D04A"],[29,62,3.2,"#F2D04A"],[40,58,3.2,"#F2D04A"],[24,72,3,"#F2D04A"],[36,70,3.2,"#F2D04A"],[30,83,2.6,"#F2D04A"],[44,80,3,"#E8833A"]],"under":["#D9C38A","#E2CF98","#2A2620"]}},
    {"id":"blue-triangle","name":"Blue Triangle","latin":"Graphium choredon","raisedBy":"maths","lines":[{"text":"Its wings are black above and brown below, with large turquoise patches in the middle.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/choredon.html","publisher":"Butterfly House"}},{"text":"Its young caterpillars are dark grey and hairy with a pale yellow tail, and later turn green.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/choredon.html","publisher":"Butterfly House"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#22262E","cells":{"1":"#3FC1C9","2":"#3FC1C9","5":"#3FC1C9","6":"#3FC1C9"},"under":["#6B5444","#7A5E4A","#3FC1C9"]}},
    {"id":"great-purple-emperor","name":"Great Purple Emperor","latin":"Sasakia charonda","raisedBy":"japanese","lines":[{"text":"Well known as Japan's national butterfly, though no law made it one. The male's wings are purple on top.","source":{"url":"https://www.pref.kyoto.jp/kankyo/rdb/bio/db/ins0255.html","publisher":"Kyoto Prefecture, Red Data Book 2015"}},{"text":"Its caterpillars eat hackberry (enoki) leaves, and spend the winter under dry leaves at the foot of the tree.","source":{"url":"https://www.pref.kyoto.jp/kankyo/rdb/bio/db/ins0255.html","publisher":"Kyoto Prefecture, Red Data Book 2015"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#4A3A3A","cells":{"1":"#7C5CC4","2":"#7C5CC4","5":"#7C5CC4","6":"#7C5CC4"},"dots":[[14,20,1.6,"#fff"],[10,28,1.5,"#fff"],[25,15,1.4,"#fff"],[24,72,1.7,"#fff"],[29,82,1.6,"#fff"],[41,84,2.2,"#E0573A"]],"under":["#D9D4B8","#E3DFC8","#4A3A3A"]}},
    {"id":"orchard-swallowtail","name":"Orchard Swallowtail","latin":"Papilio aegeus","raisedBy":"coding","lines":[{"text":"A large black and white butterfly, common in Sydney's suburban gardens from October to May.","source":{"url":"https://australian.museum/learn/animals/insects/orchard-butterfly/","publisher":"Australian Museum"}},{"text":"Early on, its caterpillars look like fresh bird droppings.","source":{"url":"https://australian.museum/learn/animals/insects/orchard-butterfly/","publisher":"Australian Museum"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#1F1D24","cells":{"0":"#F1E9D2"},"dots":[[36,62,4,"#F1E9D2"],[44,82,2.4,"#D9433A"]],"under":["#2A2730","#3A3640","#E8C24A"]}},
    {"id":"australian-painted-lady","name":"Australian Painted Lady","latin":"Vanessa kershawi","raisedBy":"javascript","lines":[{"text":"Known for migrating in late winter and early spring, from the north of the east coast towards the south-west.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/kershawi-v.html","publisher":"Butterfly House"}},{"text":"Its caterpillar hides by day in a curled leaf and feeds at night, on plants from the daisy family.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/kershawi-v.html","publisher":"Butterfly House"}}],"art":{"fore":"#E8742E","hind":"#F09A3E","tip":"#24201F","dots":[[11,21,1.3,"#fff"],[9,28,1.3,"#fff"],[15,15,1.2,"#fff"],[16,23,1.2,"#fff"],[38,31,3.2,"#24201F"],[44,43,2.4,"#24201F"]],"eyes":[[26,73,2.3,"#24201F","#5B8DEF"],[32,82,2.3,"#24201F","#5B8DEF"],[42,84,2.1,"#24201F","#5B8DEF"]],"under":["#C9A07A","#B08A6A","#F2F0E8"]}},
    {"id":"blue-tiger","name":"Blue Tiger","latin":"Tirumala hamata","raisedBy":"typescript","lines":[{"text":"In some years, Blue Tigers in Australia migrate south in great numbers, a delightful sight.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/hamata.html","publisher":"Butterfly House"}},{"text":"Adults have been seen living for longer than five months.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/hamata.html","publisher":"Butterfly House"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#1E2230","cells":{"0":"#A9D3F0","1":"#A9D3F0","2":"#A9D3F0","3":"#A9D3F0","4":"#A9D3F0","5":"#A9D3F0"},"dots":[[9,30,1.3,"#fff"],[13,16,1.2,"#fff"],[27,87,1.3,"#fff"]],"under":["#3A3F52","#4A4F62","#A9D3F0"]}},
    {"id":"common-crow","name":"Common Crow","latin":"Euploea corinna","raisedBy":"testing","lines":[{"text":"Its chrysalis is shiny, silvery gold, yet it isn't metal at all.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/corinna.html","publisher":"Butterfly House"}},{"text":"Black, with small white spots along the wing edges and bigger ones further in.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/corinna.html","publisher":"Butterfly House"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#3B2F2B","hind":"#43352F","dots":[[12,20,1.4,"#fff"],[9,29,1.4,"#fff"],[14,39,1.3,"#fff"],[22,14,1.3,"#fff"],[23,80,1.4,"#fff"],[31,87,1.3,"#fff"],[22,70,1.3,"#fff"],[32,27,2.4,"#fff"],[38,64,2.4,"#fff"],[29,70,2.1,"#fff"]],"under":["#4A3B35","#54443D","#fff"]}},
    {"id":"common-brown","name":"Common Brown","latin":"Heteronympha merope","raisedBy":"calm","lines":[{"text":"Out in spring and summer, when there is sunshine and plenty of flowers to feed on.","source":{"url":"https://australian.museum/learn/animals/insects/common-brown-butterfly/","publisher":"Australian Museum"}},{"text":"Males spend their time gently fluttering above the ground.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/merope.html","publisher":"Butterfly House"}}],"art":{"fore":"#C98A44","hind":"#BD7D3C","edge":"#8A5A2A","edgeW":1.6,"eyes":[[17,22,3.2],[32,78,2.6]],"under":["#C7A27A","#A88A66","#6E4A2A"]}},
    {"id":"wanderer","name":"Wanderer","latin":"Danaus plexippus","raisedBy":"move","lines":[{"text":"Also called the monarch. The earliest sighting of one in Sydney was in 1871.","source":{"url":"https://australian.museum/learn/animals/insects/wanderer-butterfly/","publisher":"Australian Museum"}},{"text":"Orange-brown, with black wing veins.","source":{"url":"https://australian.museum/learn/animals/insects/wanderer-butterfly/","publisher":"Australian Museum"}}],"art":{"fore":"#E8892C","hind":"#EE9A3E","veins":"#1F1A1A","edge":"#1F1A1A","edgeW":3.2,"dots":[[10.5,30,1.3,"#fff"],[12.5,21,1.2,"#fff"],[26,85,1.3,"#fff"],[35,87,1.2,"#fff"]],"under":["#E9A55A","#F0C080","#1F1A1A"]}},
    {"id":"varied-eggfly","name":"Varied Eggfly","latin":"Hypolimnas bolina","raisedBy":"break","lines":[{"text":"The male is black with a large white spot in the middle of each wing.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/bolina.html","publisher":"Butterfly House"}},{"text":"The name Eggfly refers to the white oval patch on the forewing.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/bolina.html","publisher":"Butterfly House"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#1E1B22","cells":{"1":"#7A5CC0","5":"#7A5CC0"},"dots":[[40,40,4.6,"#fff"],[36,62,5,"#fff"],[10,30,1.2,"#fff"],[13,20,1.2,"#fff"],[25,84,1.3,"#fff"]],"under":["#6A4E3A","#7A5E46","#F2F0E8"]}},
    {"id":"glasswing","name":"Glasswing","latin":"Acraea andromacha","raisedBy":"reflect","lines":[{"text":"Its forewings are see-through, with black spots.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/andromacha.html","publisher":"Butterfly House"}},{"text":"Its mouthparts are an unusual bright yellow.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/andromacha.html","publisher":"Butterfly House"}}],"art":{"fore":"#FFFFFF","clear":true,"hind":"#FFFFFF","edge":"#1E1B1E","edgeW":3.6,"dots":[[30,30,2.2,"#1E1B1E"],[40,38,2,"#1E1B1E"],[22,24,1.8,"#1E1B1E"],[24,80,1.2,"#fff"],[33,86,1.2,"#fff"]],"under":["#E8E4DA","#FFFFFF","#1E1B1E"]}},
    {"id":"cairns-birdwing","name":"Cairns Birdwing","latin":"Ornithoptera euphorion","raisedBy":"focus","lines":[{"text":"Males are green and black, females black and white, and both have yellow spots on their hindwings.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/euphorion.html","publisher":"Butterfly House"}},{"text":"Found in north Queensland, between Cooktown and Mackay, where its caterpillars eat Aristolochia vines.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/euphorion.html","publisher":"Butterfly House"}}],"art":{"fore":"#1E2A22","hind":"#3DBB6A","cells":{"0":"#3DBB6A","2":"#3DBB6A","5":"#3DBB6A"},"edge":"#CDBFA8","edgeW":1.8,"dots":[[24,72,2.4,"#F2D04A"],[28,83,2.4,"#F2D04A"],[39,85,2.2,"#F2D04A"]],"under":["#1E2A22","#3DBB6A","#F2D04A"]}},
    {"id":"evening-brown","name":"Evening Brown","latin":"Melanitis leda","raisedBy":"winddown","lines":[{"text":"In winter it is dark brown, with an orange patch holding a double eyespot near each forewing tip.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/leda.html","publisher":"Butterfly House"}},{"text":"Its eggs are laid at dusk, on the underside of young leaves.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/leda.html","publisher":"Butterfly House"}}],"art":{"fore":"#6B5D52","hind":"#73655A","cells":{"0":"#D98A3A"},"eyes":[[19,24,2.6],[26,19,2],[33,78,2.2,"#D98A3A"]],"under":["#9C8466","#8A7258","#E8DCC0"]}},
    {"id":"caper-white","name":"Caper White","latin":"Belenois java","raisedBy":"walk","lines":[{"text":"In spring many fly inland, west of the Great Dividing Range, to where caper plants are more common.","source":{"url":"https://australian.museum/learn/animals/insects/caper-white-butterfly/","publisher":"Australian Museum"}},{"text":"Its caterpillars eat only plants from the caper family.","source":{"url":"https://australian.museum/learn/animals/insects/caper-white-butterfly/","publisher":"Australian Museum"}}],"art":{"fore":"#FBFAF6","hind":"#F3EFE4","tip":"#2E2A30","edge":"#2E2A30","edgeW":1.6,"dots":[[30,80,2.2,"#F2D04A"]],"under":["#F7F3E8","#F2D04A","#2E2A30"]}},
    {"id":"yellow-admiral","name":"Yellow Admiral","latin":"Vanessa itea","raisedBy":"read","lines":[{"text":"Orange and black, with a big pale yellow patch on each forewing.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/itea.html","publisher":"Butterfly House"}},{"text":"When it lands, it flashes its wings to show that bright yellow spot.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/itea.html","publisher":"Butterfly House"}}],"art":{"edge":"#CDBFA8","edgeW":1.8,"fore":"#2A2420","cells":{"1":"#E07A3A","2":"#F2E08A","5":"#E07A3A"},"dots":[[10,28,1.3,"#fff"],[13,19,1.2,"#fff"]],"under":["#8C7A62","#7A6A56","#F2E08A"]}},
    {"id":"lemon-migrant","name":"Lemon Migrant","latin":"Catopsilia pomona","raisedBy":"water","lines":[{"text":"The male is white with black wingtips. The female is pale yellow with black edges and spots.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/pier/pomona.html","publisher":"Butterfly House"}},{"text":"Its caterpillar rests along the middle of a leaf, which makes it very hard to see.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/pier/pomona.html","publisher":"Butterfly House"}}],"art":{"fore":"#F4E27A","hind":"#F7EA9A","edge":"#3A3222","edgeW":1.8,"dots":[[30,28,1.8,"#3A3222"]],"under":["#F4E27A","#F7EA9A","#C9A23A"]}},
    {"id":"meadow-argus","name":"Meadow Argus","latin":"Junonia villida","raisedBy":"outside","lines":[{"text":"Often seen sunning itself on the ground with its wings open.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/villida.html","publisher":"Butterfly House"}},{"text":"Brown on top, with orange and white markings and blue eyespots.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/villida.html","publisher":"Butterfly House"}}],"art":{"fore":"#6E5034","cells":{"1":"#E58A3A","2":"#E58A3A","4":"#E58A3A","5":"#E58A3A"},"dots":[[22,18,2.4,"#F4EEDD"]],"eyes":[[16,31,3,"#E58A3A","#5B8DEF"],[29,76,2.4,"#F4EEDD","#5B8DEF"],[39,81,2.1,"#F4EEDD","#5B8DEF"]],"under":["#B89A74","#A08460","#E58A3A"]}},
    {"id":"orange-migrant","name":"Orange Migrant","latin":"Catopsilia scylla","raisedBy":"floss","lines":[{"text":"The male's forewings are white with black margins, and its hindwings are yellow.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/pier/scylla.html","publisher":"Butterfly House"}},{"text":"Its caterpillars feed on Senna, especially kinds with large flowers.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/pier/scylla.html","publisher":"Butterfly House"}}],"art":{"fore":"#FBFAF6","hind":"#F5C93A","tip":"#2E2A30","edge":"#2E2A30","edgeW":2.2,"under":["#F5D23A","#F2C84A","#D9822E"]}},
    {"id":"regent-skipper","name":"Regent Skipper","latin":"Euschemon rafflesia","raisedBy":"music","lines":[{"text":"Dark brown on top with yellow and blue markings, and greenish underneath.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/hesp/rafflesia.html","publisher":"Butterfly House"}},{"text":"Its caterpillars live in a shelter of two leaves joined with silk.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/hesp/rafflesia.html","publisher":"Butterfly House"}}],"art":{"fore":"#2A2220","hind":"#2A2220","edge":"#CDBFA8","edgeW":1.8,"cells":{"0":"#F5C42E","3":"#F5C42E"},"dots":[[24,74,2.2,"#5B8DEF"],[29,83,2.2,"#5B8DEF"],[38,86,2,"#5B8DEF"],[42,40,2.6,"#F5C42E"]],"under":["#6E8A4A","#7E9A5A","#F2C230"]}},
    {"id":"dainty-swallowtail","name":"Dainty Swallowtail","latin":"Papilio anactus","raisedBy":"make","lines":[{"text":"Black and white, with red and smaller blue spots along the edge of each hindwing.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/anactus.html","publisher":"Butterfly House"}},{"text":"Males hold territories, and the same ones are used year after year.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/anactus.html","publisher":"Butterfly House"}}],"art":{"fore":"#DCDAD4","hind":"#1E1B22","tip":"#1E1B22","veins":"#1E1B22","edge":"#CDBFA8","edgeW":1.8,"dots":[[24,77,2.6,"#D8372A"],[29,85,2.6,"#D8372A"],[38,87,2.4,"#D8372A"],[46,84,1.7,"#5B8DEF"]],"under":["#DCDAD4","#1E1B22","#D8372A"]}},
    {"id":"lurcher","name":"Lurcher","latin":"Yoma sabina","raisedBy":"call","lines":[{"text":"Brown, with a broad orange stripe across both wings.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/sabina.html","publisher":"Butterfly House"}},{"text":"The male has a yellow mark in the black tip of each forewing, the female a white one.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/sabina.html","publisher":"Butterfly House"}}],"art":{"fore":"#5A3E2A","hind":"#5A3E2A","tip":"#1E1B1E","edge":"#CDBFA8","edgeW":1.8,"cells":{"2":"#E8862E","5":"#E8862E","1":"#E8862E"},"dots":[[32,40,5,"#E8862E"],[36,50,5.5,"#E8862E"],[14,20,2.2,"#F2D04A"]],"under":["#B89A74","#7A5E44","#5A3E2A"]}},
    {"id":"common-aeroplane","name":"Common Aeroplane","latin":"Neptis praslini","raisedBy":"tidy","lines":[{"text":"Black, with white spots and a large white patch on each hindwing.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/praslini.html","publisher":"Butterfly House"}},{"text":"Its caterpillar rests on the underside of a leaf when it is not feeding.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/praslini.html","publisher":"Butterfly House"}}],"art":{"fore":"#1E1B22","hind":"#1E1B22","edge":"#CDBFA8","edgeW":1.8,"cells":{"1":"#F4F1E8","4":"#F4F1E8","6":"#F4F1E8"},"dots":[[14,22,2,"#F4F1E8"],[22,30,2.6,"#F4F1E8"],[30,36,2.8,"#F4F1E8"],[38,42,3,"#F4F1E8"],[26,18,1.8,"#F4F1E8"]],"under":["#2A2630","#F4F1E8","#F4F1E8"]}},
    {"id":"red-lacewing","name":"Red Lacewing","latin":"Cethosia cydippe","raisedBy":"own","lines":[{"text":"Scarlet wings with broad black edges, and a white patch across each forewing tip.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/cydippe.html","publisher":"Butterfly House"}},{"text":"Its caterpillars are black with yellow bands, and feed on passionfruit vines.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/cydippe.html","publisher":"Butterfly House"}}],"art":{"fore":"#D8352A","hind":"#DE4A32","edge":"#1E1B1E","edgeW":5,"dots":[[16,22,3,"#fff"],[22,18,2.6,"#fff"],[25,86,1.2,"#fff"],[34,88,1.1,"#fff"]],"under":["#E8A060","#E89A70","#1E1B1E"]}},
    {"id":"tailed-emperor","name":"Tailed Emperor","latin":"Charaxes sempronius","raisedBy":"own","lines":[{"text":"Mostly cream and black above, with two narrow pointed tails on each hindwing.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/sempronius.html","publisher":"Butterfly House"}},{"text":"Drawn to fermenting juice, such as rotting fruit or sap.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/sempronius.html","publisher":"Butterfly House"}}],"art":{"fore":"#1E1B1E","hind":"#F2E6C0","cells":{"2":"#F2E6C0","3":"#F2E6C0","5":"#F2E6C0"},"tails":true,"edge":"#CDBFA8","edgeW":1.8,"under":["#B8A07A","#C8B08A","#5A3A2A"]}},
    {"id":"macleays-swallowtail","name":"Macleay's Swallowtail","latin":"Graphium macleayanum","raisedBy":"own","lines":[{"text":"Green on top, with black and white markings.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/macleayanum.html","publisher":"Butterfly House"}},{"text":"Males gather around hilltops, where they defend their territory.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/papi/macleayanum.html","publisher":"Butterfly House"}}],"art":{"fore":"#A8D8A0","tip":"#1E1B1E","edge":"#1E1B1E","edgeW":2.4,"dots":[[12,24,1.4,"#fff"],[15,17,1.3,"#fff"],[34,66,2.6,"#1E1B1E"]],"under":["#A8D8A0","#B8E0B0","#5A3A2A"]}},
    {"id":"australian-leafwing","name":"Australian Leafwing","latin":"Doleschallia bisaltide","raisedBy":"own","lines":[{"text":"Orange on top, with a broad dark area around the wingtips.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/bisaltide.html","publisher":"Butterfly House"}},{"text":"Resting with its wings closed over its back, it looks like a leaf.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/nymp/bisaltide.html","publisher":"Butterfly House"}}],"art":{"fore":"#E8842E","hind":"#E8842E","tip":"#4A2E3A","edge":"#4A2E3A","edgeW":8,"under":["#7A5A5E","#6E5054","#E8DCC0"]}},
    {"id":"cabbage-white","name":"Cabbage White","latin":"Pieris rapae","raisedBy":"own","lines":[{"text":"White, with black tips to the forewings. Males have one black spot on each forewing, females two.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/pier/rapae.html","publisher":"Butterfly House"}},{"text":"Not native to Australia, it reached Melbourne in 1929 and Perth in 1943.","source":{"url":"https://www.lepidoptera.butterflyhouse.com.au/pier/rapae.html","publisher":"Butterfly House"}}],"art":{"fore":"#FAF8F2","tip":"#3A3A3A","edge":"#D8D2C2","edgeW":1.2,"dots":[[34,30,2.6,"#3A3A3A"]],"under":["#FAF8F2","#F2E9A8","#3A3A3A"]}}
  ]
}
