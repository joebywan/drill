<?xml version="1.0" encoding="utf-8"?>
<!--
    NO INTERNET PERMISSION, on purpose. Every byte the page loads comes out of the APK's assets
    through WebViewAssetLoader (https://appassets.androidplatform.net), so there is no route off the
    device. CI fails the build if a dependency ever merges INTERNET back in.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The once-a-day note, opt-in on the ⋯ screen; asked for only when it is switched on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android drops alarms on reboot: re-arm the widget refresh and the note. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drill"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".Widget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Exported for BOOT_COMPLETED; the actions it acts on are listed in Ticker. -->
        <receiver
            android:name=".Ticker"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
